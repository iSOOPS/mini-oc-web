# Web server bind
WEB_PORT=8100
WEB_BIND=0.0.0.0

# Cookie HMAC key path (auto-generated if missing)
COOKIE_KEY_PATH=/data/cookie_key

# Unified device-hop credentials (fallback for the BFF→device API calls;
# must equal OPENCODE_SERVER_USERNAME/PASSWORD on each device).
# NOT used for portal login — users log in with per-user 32-char keys
# created by the admin at /admin.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=YOUR_PASSWORD_HERE

# SilverBullet endpoint. SB_PASSWORD also serves as the super-admin
# password for the /admin management console.
SB_BASE_URL=http://127.0.0.1:3000
SB_USER=admin
SB_PASSWORD=YOUR_PASSWORD_HERE

# Rathole (cloud tunnel) key — displayed on the admin page as 云服务密钥
RATHOLE_KEY=YOUR_RATHOLE_KEY_HERE

# Static SPA directory
WEB_STATIC_DIR=./web/dist

# Portal host (the URL users actually visit). Used to build deep-link
# URLs of the form `{PORTAL_BASE}/{b64pc}/{b64dir}/session/{sid}`.
PORTAL_BASE=https://oc.isoops.com
